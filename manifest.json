{
  "manifest_version": 3,
  "name": "Pixiv Viewed Marker",
  "description": "Mark Pixiv artwork titles that have already been opened, using local extension storage.",
  "version": "0.1.0",
  "permissions": ["storage", "tabs"],
  "optional_permissions": ["history"],
  "host_permissions": ["https://www.pixiv.net/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Pixiv Viewed Marker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "css": [
        "src/content/content.css",
        "src/content/author-panel.css"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/url-parser.js",
        "src/shared/storage.js",
        "src/content/content.js",
        "src/content/pvm-author-core.js",
        "src/content/pvm-hover-preview.js",
        "src/content/pvm-author-page.js",
        "src/content/pvm-artwork-panel.js",
        "src/content/pvm-artwork-sections.js",
        "src/content/pvm-author-bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
